FRONTEND_WEBCAPTIONER_SERVER=http://localhost:4000
FRONTEND_YOUTUBE_REGION=reg1#cue1
# options: 'ctranslate', 'fairseq', 'passthrough'
FRONTEND_DEFAULT_SOTRA_MODEL=fairseq
FRONTEND_DEFAULT_YOUTUBE_TIME_OFFSET=8
FRONTEND_MAX_LINES_IN_HISTORY=5
FRONTEND_DEFAULT_VOSK_SAMPLE_RATE=48000
FRONTEND_RECORDING_INFORMATION_LINE=
FRONTEND_DEFAULT_AUDIO_FORMAT=mp3
#FRONTEND_SEND_TIMESTAMP=
#FRONTEND_SEND_TIMESTAMP_COUNT=
#FRONTEND_DEFAULT_TRANSLATION_TARGET_LANGUAGE=

VOSK_SAMPLE_RATE=48000
VOSK_LOG_AUDIO=false
VOSK_SHOW_WORDS=True

# disable to fall back to WebRTC
VOSK_VAD_ALGO=Silero

WEBCAPTIONER_BACKEND_PORT=4000
SOTRA_SERVER_CTRANSLATE_URL=http://webcaptioner-sotra-ctranslate:25000
SOTRA_SERVER_FAIRSEQ_URL=http://webcaptioner-sotra-fairseq:3000
CONFIG=/app/config

MONGO_INITDB_ROOT_USERNAME=mojewuziwarskemjeno
MONGO_INITDB_ROOT_PASSWORD=mojeheslo
MONGOSH_FORCE_DISABLE_TELEMETRY_FOR_TESTING=1

MONGODB_USERNAME=mojewuziwarskemjeno
MONGODB_PASSWORD=mojeheslo
MONGODB_DATABASE=webcaptioner
MONGODB_HOST=webcaptioner-ng-back-mongo:27017

JWT_SECRET_KEY=mojtajnykluc
FREE_PASSWORD=lucija

DB_ADMIN_FIRSTNAME=Lucija
DB_ADMIN_LASTNAME=Zalozba
DB_ADMIN_EMAIL=lucija@zalozba.de
DB_ADMIN_PASSWORD=lucija

BAMBORAK_SERVER=http://bamborak-backend:8080

VOSK_HUNSPELL_AFF_FILE=/model/hsb_DE_soblex_w8_3.09.18.aff 
VOSK_HUNSPELL_DIC_FILE=/model/hsb_DE_soblex_w8_3.09.18.dic

VOSK_WHISPER_NO_FALLBACK=true
VOSK_WHISPER_DISABLE_TIMESTAMPS=True

MODEL_PATH_FULL=/whisper/Korla/whisper_large_v3_turbo_hsb-v1/ggml-model.bin
VOSK_MODEL_LANGUAGE=czech
VOSK_REPLACEMENT_FILE=/whisper/Korla_whisper_large_v3_turbo_hsb-0.txt
VOSK_PROB_THRESHOLD_REJECT=0.80
VOSK_LOGPROB_THRESHOLD_REJECT=-1.0
VOSK_REJECT_RESPONSE=njezrozumliwe
VOSK_PROB_THRESHOLD_DISCARD=0.70
VOSK_LOGPROB_THRESHOLD_DISCARD=-1.5
